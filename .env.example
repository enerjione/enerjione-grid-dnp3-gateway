# ============================================================================
# EnerjiOne DNP3 Gateway — ornek ortam degiskenleri (.env)
# ----------------------------------------------------------------------------
# Bu dosyayi `.env` olarak kopyalayin ve KENDI degerlerinizle doldurun:
#     Windows: Copy-Item .env.example .env
#     Linux  : cp .env.example .env
#
# Gateway sahadan DNP3 cihazlarini poll eder ve telemetri'yi backend HTTP
# ingest endpoint'ine (`/api/v1/telemetry/gateway/<GATEWAY_CODE>`) yollar.
# Backend ayni outbox/event pipeline'ina yazar; tag-engine consume eder.
#
# Tum alanlarin tam aciklamasi icin: src/dnp3_gateway/config.py
# ============================================================================


# ============================================================================
# 1) GATEWAY KIMLIK BILGILERI (ZORUNLU)
# ============================================================================

# Backend `gateways.code` ile BIREBIR ayni olmali (case-sensitive).
# Sahada N gateway -> N farkli kod (GW-001, GW-002, ...).
GATEWAY_CODE=GW-001

# Backend `gateways.token` ile BIREBIR ayni olmali.
# Production'da:
#   * Minimum 32 karakter (validator zorlar)
#   * Placeholder prefix (`change-me`, `gw-default`, `gw-001-token` vb.)
#     kullanilamaz — validator reddeder
#   * Rastgele uretilen yuksek-entropy bir deger olmali:
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_TOKEN=gw-001-token

# Insan-okur isim; loglarda ve /info endpoint'inde gozukur. Saha lokasyonu
# yazmak operatore yardimci olur.
GATEWAY_NAME=EnerjiOne DNP3 Gateway 01


# ============================================================================
# 2) ORTAM SECIMI (ZORUNLU)
# ============================================================================

# Degerler: development | staging | production (kisa: dev, stg, prod)
#
# Production'da ek validator kontrolleri ACILIR:
#   * BACKEND_API_URL public host ise https:// zorunlu
#   * NATS_URL bos olamaz, public host ise tls:// zorunlu
#   * GATEWAY_TOKEN >=32 karakter + placeholder prefix yasak
#   * SHOW_GATEWAY_TOKEN_ON_START false olmali
#   * GATEWAY_REFRESH_TOKEN != GATEWAY_TOKEN
#   * RABBITMQ_URL set edilemez (0.4.x'te cutover)
#   * NATS_DUAL_PUBLISH_ENABLED true olamaz (DEPRECATED)
#
# Sahaya cikarken: production. Yerel test: development.
APP_ENVIRONMENT=development


# ============================================================================
# 3) BACKEND API (ZORUNLU)
# ============================================================================

# Backend public/internal URL. `/api/v1` ile bitmeli; gateway bu URL'den
# `/gateways/{code}/config` cagrisi yapar.
#
# Production tercih: https://backend.kurum.local/api/v1
# Saha (private LAN/loopback): http://192.168.1.10:8000/api/v1
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# TLS sertifika dogrulamasi. Production'da TRUE zorunlu (false validator
# tarafindan reddedilir; MITM riski).
BACKEND_API_VERIFY_SSL=true

# Kurumsal/self-signed CA varsa PEM bundle yolu. Bos ise sistem trust store.
# BACKEND_API_CA_PATH=C:/certs/corp-root.pem
BACKEND_API_CA_PATH=

# Backend config endpoint'i kac saniyede bir cagrilir. Saglikli durumda
# sabit interval; hata durumunda exponential backoff (max 5dk cap).
CONFIG_REFRESH_SEC=30

# Tek istek timeout'u (sn). Backend cevap vermezse exponential backoff'a
# duser; cycle bloklanmaz.
CONFIG_TIMEOUT_SEC=5

# Command-poll READ timeout (sn). Config fetch'ten AYRI session + kisa timeout;
# poll takilmadan hizli hata verip bir sonraki turda yeniden dener. 200 cihaz
# yukunde "command_poll_error Read timed out" onlenir.
COMMAND_POLL_TIMEOUT_SEC=4

# Disk'teki config cache'i kac SAATTEN daha eski olunca `stale` kabul
# edilir. Backend uzun sure down olsa bile gateway eski IP/sinyal listesiyle
# polling'e devam eder; /health "config_cache_stale" issue raporlar.
CONFIG_CACHE_MAX_AGE_HOURS=24


# ============================================================================
# 4) TELEMETRI YAYINLAMA
# ============================================================================

# STANDART: nats -> dogrudan JetStream (telemetri backend'e ugramaz).
# Rollback: http -> backend HTTP ingest (her olcum backend + Postgres outbox
# zincirinden gecer; yalnizca bilincli geri donus icin).
TELEMETRY_PUBLISHER=nats

# JetStream server adresi (TELEMETRY_PUBLISHER=nats iken zorunlu).
# Production'da nats secilirse bos olamaz; public host icin tls:// zorunlu,
# private/loopback host icin nats:// kabul.
#   Compose icinden : nats://nats:4222
#   Ayri host'tan   : nats://<broker-ip>:4222
#   TLS uretim      : tls://nats.kurum.local:4222
NATS_URL=nats://localhost:4222

# JetStream subject prefix. Konkre subject `<prefix>.<gateway_code>`
# olusturulur (orn. `e1.telemetry.raw.GW-001`). Backend stream
# TELEMETRY_RAW bu prefix'i `e1.telemetry.raw.>` wildcard ile yakalar.
NATS_SUBJECT_PREFIX=e1.telemetry.raw

# Connect timeout (sn). Kisa tutun ki gateway startup'i NATS yokken
# bloklanmasin — connect basarisiz olsa bile gateway ayaga kalkar,
# mesajlar outbox'a yazilir, baglanti gelince retrier bosaltir.
NATS_CONNECT_TIMEOUT_SEC=5

# Tek mesaj publish timeout (sn). 2.0 default tipik LAN/4G icin makul;
# bu sureyi asan publish OutboxFullError'a sebep olmadan exception'la
# doner, mesaj outbox'a yazilir.
NATS_PUBLISH_TIMEOUT_SEC=2.0

# NATS auth (NKEY/JWT credentials). `nsc generate user --account ENERJIONE
# --name gateway-GW001` ile uretip gateway host'una koyup yolunu set edin.
# Production'da onerilir; bos ise URL'deki `nats://user:pass@host` kullanilir,
# o da yoksa NATS server anonim baglanti red eder (deny-all default).
# NATS_CREDENTIALS_PATH=/etc/enerjione/gateway-GW001.creds
NATS_CREDENTIALS_PATH=

# NATS sunucusunun TLS sertifikasini dogrulamak icin kurumsal/self-signed
# CA bundle (PEM). Bos ise system trust store. Tls:// scheme ile kullanilir.
# NATS_TLS_CA_PATH=/etc/enerjione/nats-ca.pem
NATS_TLS_CA_PATH=


# ============================================================================
# 5) GATEWAY CALISMA MODU (ZORUNLU)
# ============================================================================

# Degerler:
#   mock -> Gercek DNP3 olmadan mantikli rastgele deger uretir (test/dev).
#   dnp3 -> Gercek cihazlara TCP uzerinden DNP3 master baglantisi kurar.
#
# Sahada: dnp3. Backend smoke test: mock.
GATEWAY_MODE=mock

# DNP3 master kutuphanesi:
#   yadnp3 (ONERILEN) — OpenDNP3 reference; Group 110 (Octet String) destegi
#   dnp3py (FALLBACK) — saf python (nfm-dnp3); Group 110 YOK
DNP3_LIBRARY=yadnp3


# ============================================================================
# 6) DNP3 PARAMETRELERI (DNP3 modu icin)
# ============================================================================

# Bu master'in DNP3 link-layer adresi. Outstation bunu bekler (genelde 1).
# Cihaz basina backend `master_address` ile override edilebilir.
DNP3_LOCAL_ADDRESS=1

# Varsayilan DNP3 TCP port. Cihaz backend config'inde `dnp3_tcp_port`
# verirse o baskindir.
DNP3_TCP_PORT=20000

# Tek bir DNP3 yaniti icin maksimum bekleme (sn). 4G/yavas linklerde 8-15.
DNP3_RESPONSE_TIMEOUT_SEC=8

# Okuma stratejisi (event_driven onerilen):
#   event_driven — Class 1+2+3 event scan + periyodik Class 0 baseline
#                  (degisen sinyalleri yayinlar; 100+ cihaz icin onerilen)
#   direct       — grup+index araligi (hafif, simulator uyumlu)
#   class0       — sadece statik (her cycle hepsini yayinlar)
#   integrity    — tum classlar (en kapsamli, en yorucu)
DNP3_READ_STRATEGY=event_driven

# event_driven mod: bu kadar saniyede bir Class 0 (tam baseline) tazelenir.
# Class 1/2/3 EVENT SCAN araligi (sn). 0 = DEFAULT_POLL_INTERVAL_SEC ile ayni.
# Poll interval YAYIN turudur; bu ise cihaza "yeni olayin var mi" SORMA sikligi.
# 401 cihazda scan=1s saniyede 401 DNP3 istegi uretir ve CPU cihaz sayisiyla
# artar. Cihazlar unsolicited gonderdigi icin scan yedek mekanizmadir; 3-5 sn
# tipik olarak veri tazeligini bozmadan yuku belirgin dusurur.
# Degistirdikten sonra /health `devices.oldest_frame_age_sec` izleyin.
DNP3_EVENT_SCAN_INTERVAL_SEC=0
DNP3_EVENT_BASELINE_INTERVAL_SEC=60

# Cihaz IP ALLOWLIST (CIDR listesi, virgulle ayrik). Bos ise tum IP'ler
# kabul (geriye uyumlu). PRODUCTION'DA MUTLAKA SET EDIN — backend
# kompromize olursa gateway'i `169.254.169.254` (cloud metadata) veya
# internet host'una baglatma riskini kapatir (SSRF/scan koruma).
#
# Ornek: DNP3_DEVICE_ALLOWED_SUBNETS=192.168.10.0/24,10.0.5.0/24,172.16.20.0/24
DNP3_DEVICE_ALLOWED_SUBNETS=


# ============================================================================
# 7) POLLING / PARALELLIK
# ============================================================================

# Poller "uyanma" araligi (sn). Saniyede bir due_devices kontrolu yapar.
# Event-driven mod degisiklik yoksa publish etmez — yuk minimal.
DEFAULT_POLL_INTERVAL_SEC=1

# Tek cycle'da paralel okunabilecek cihaz sayisi. Hedef kapasite tek
# gateway'de 500 cihaz (1.2.0+); havuz tembel buyudugu icin kucuk sahada
# 500'un maliyeti yok. Cihazlarin TCP cevap suresi <100ms oldugu icin
# 500 paralel okumada cycle 1sn altinda biter.
MAX_PARALLEL_DEVICES=500

# Tek cihaz icin poll+publish maksimum sure (sn). Hangat cihaz tum
# cycle'i bloke etmesin diye cap. Kopuk cihaz worker'i bu sure boyunca
# isgal eder — 300+ cihazda 30sn havuzu ac birakiyordu, varsayilan 15.
# WAN'da integrity poll'u 15sn'i asan saha varsa yukseltin.
DEVICE_POLL_TIMEOUT_SEC=15

# Tum cycle (paralel due_devices) icin global timeout (sn).
CYCLE_TIMEOUT_SEC=120


# ============================================================================
# 8) HEALTH HTTP ENDPOINT
# ============================================================================

# Bind host. Container icinde 0.0.0.0; bare-metal/NSSM kurulumda 127.0.0.1.
# Backend `/refresh-all` cagirisi yapacaksa reverse proxy veya VPN ile
# gateway'e ulasabilmeli — 127.0.0.1 sadece local erisim demek.
WORKER_HEALTH_HOST=127.0.0.1

# Port. 0 -> OS rastgele bos port atar (gercek port log'da ve /health'te
# gorunur). Ayni PC'de coklu gateway icin her birine ayri port verin
# (8020, 8021, 8022, ...).
WORKER_HEALTH_PORT=8020

# Reverse-proxy CIDR allowlist (virgulle ayrik). `X-Forwarded-For` header'i
# SADECE bu subnet'lerden gelen istekler icin okunur — gercek client IP'sini
# proxy chain'in en disindan cikarir (nginx `real_ip` mantigi). Bos ise XFF
# tamamen yok sayilir (en guvenli default; saldirgan XFF spoofing yapip
# rate-limit'i bypass edemez).
#
# nginx/Caddy/Traefik arkasinda calistiriliyorsa proxy IP'sini set edin.
# Ornek: HEALTH_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5/32
HEALTH_TRUSTED_PROXIES=


# ============================================================================
# 9) OPERATOR ENDPOINT — /refresh-all (OPSIYONEL)
# ============================================================================

# POST /refresh-all endpoint'i icin AYRI Bearer token. Backend operator
# panelinden "tum cihazlara sorgu at" butonu bu endpoint'i tetikler.
# Production'da GATEWAY_TOKEN'dan FARKLI olmali; ayni ise backend tokeni
# leak olunca uzaktan tum cihazlari yorma kapisi acilir (validator zorlar).
# Bos birakilirsa endpoint TAMAMEN devre disi (503 doner).
#
# Yuksek-entropy uretim:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# GATEWAY_REFRESH_TOKEN=

# POST /operate endpoint'i icin AYRI Bearer token. Backend cihaz komut
# butonlarini (Trigger Download, Config Update, Reset...) bu token ile
# gateway'e proxy eder. Production'da GATEWAY_TOKEN'dan FARKLI olmali
# (validator zorlar). Bos birakilirsa endpoint TAMAMEN devre disi (503).
# GATEWAY_COMMAND_TOKEN=


# ============================================================================
# 10) LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=text

# Konsolda token: true=tam metin (sadece dev), false=maskeli. Production'da
# false zorunlu (validator zorlar) — log aggregator/console history sizinti.
SHOW_GATEWAY_TOKEN_ON_START=false

# Rotating dosya log'lama. NSSM/Windows servis stdout'u dosyaya yonlendirir
# AMA rotasyon yapmaz — 600 cihazli yuk altinda saatler icinde disk dolar.
# LOG_FILE_PATH set edilirse gateway kendi RotatingFileHandler'i acar.
#
# Yer tutucular: {gateway_code}, {instance_id} — coklu instance icin per-
# gateway ayrik dosya.
#
# Windows ornegi (NSSM kurulum icin ONERILEN):
# LOG_FILE_PATH=C:/ProgramData/EnerjiOne/dnp3-gateway/{gateway_code}.log
LOG_FILE_PATH=

# 20MB x 10 backup = 200MB instance basina ust sinir.
LOG_FILE_MAX_BYTES=20971520
LOG_FILE_BACKUP_COUNT=10


# ============================================================================
# 11) OUTBOX / DAYANIKLILIK (ileri-seviye, default'lar tipik kullanim icin OK)
# ============================================================================

# Outbox SQLite dolulu k limiti. Asilirsa publisher disk-full circuit-breaker
# tetikler ve poll cycle'i durdurur (sessiz veri kaybi yerine kontrollu
# duraklatma). Saniyede ~200 mesaj ile ~40dk broker outage karsilar.
# OUTBOX_MAX_PENDING=500000

# Bir mesaj kac kez retry edilirse dead-letter tablosuna tasinir.
# OUTBOX_MAX_RETRIES=100


# ============================================================================
# 12) DAYANIKLILIK / GUVENLIK BAYRAGI
# ============================================================================

# Production'da public host'a clear-text http://+nats:// yasak — validator
# reddeder. TLS kurulana kadar saha gateway'ini ayaga kaldirmak icin
# BILINCLI opt-out yapabilirsiniz. Default FALSE. Boot'ta loud WARN log
# atilir. PILOT SONRASI TLS KURULUNCA BU BAYRAGI KALDIRIN.
# GATEWAY_INSECURE_ALLOW_PLAINTEXT=true


# ============================================================================
# 13) LEGACY / DEPRECATED — SET ETMEYIN
# ============================================================================

# RABBITMQ_URL: Gateway 0.4.x ile RabbitMQ telemetri akisindan tamamen
# kaldirildi; production validator set edilmesini REDDEDER. Eski .env'den
# kopyaladiysaniz bu satiri SILIN. Backend tarafindaki alarm/notification
# akisi RabbitMQ'da kalir — gateway onunla ilgilenmez.

# NATS_DUAL_PUBLISH_ENABLED: DEPRECATED — 0.4.x'te JetStream tek primary
# yol. Production validator true set edilmesini REDDEDER. Satiri silin.


# ============================================================================
# 14) 300 CIHAZLIK SAHA ICIN AYARLAR (0.5.0'da eklendi)
# ============================================================================
#
# NOT: Asagidaki DNP3_* ayarlarindan bir kismi YALNIZCA legacy
# DNP3_LIBRARY=dnp3py dalinda gecerlidir. Varsayilan (ve onerilen) yadnp3
# adapter'i onlari YOK SAYAR — set ederseniz boot'ta uyari alirsiniz.
# Hangi ayarin hangi adapter'a ait oldugu asagida acikca yaziyor.

# --- yadnp3 (VARSAYILAN adapter) -------------------------------------------

# opendnp3 IO thread sayisi. 0 = otomatik (minimum 4). 100 cihazda 4-8,
# 300 cihazda 8-12 onerilir; azinda TCP I/O + scheduler isi tek havuzda
# birikir ve cihazlar periyodik olarak "stale" gorunur.
# DNP3_MANAGER_THREADS=8

# Master -> outstation zaman senkronizasyonu: lan | none
# Outstation'lar ayda 10-60sn RTC drift yapar ve guc kesintisinde saatlerini
# sifirlar. 'none' yaparsaniz cihaz olay damgalarini yanlis saatle uretir.
# Gateway saatinin sapmasi 30sn'yi asarsa yazim OTOMATIK durur.
# DNP3_TIME_SYNC=lan

# Cihazin DNP3 kalite bayraklarini (RESTART / LOCAT_FORCED / OVER_RANGE /
# REFERENCE_ERR) telemetri `quality` alanina yansit.
# VARSAYILAN KAPALI — backend tag-engine yeni kalite degerlerini tanimadan
# acmayin. Bkz. docs/BACKEND_TODO.md#B1
# DNP3_PUBLISH_QUALITY_FLAGS=false

# --- Komut kanali -----------------------------------------------------------

# Backend /pending komut-poll araligi (sn). Komutlarin cihaza ulasma
# gecikmesini belirler; config-poll'den (5dk) BAGIMSIZDIR.
# COMMAND_POLL_SEC=1

# --- Outbox retrier / kalici depolama --------------------------------------

# Outbox bosaltma dongusu. Kuyruk doluyken bu uyku ATLANIR (drenaj hizi).
# OUTBOX_RETRIER_POLL_INTERVAL_SEC=2.0
# OUTBOX_RETRIER_BATCH_SIZE=200
# OUTBOX_RETRIER_MIN_BACKOFF_SEC=1.0
# OUTBOX_RETRIER_MAX_BACKOFF_SEC=60.0

# Kalici tablolarin budanmasi (6 saatte bir calisir). RETENTION OLMADAN
# dead_letter yuz binlerce satira cikip disk dolmasinin ana kaynagi olur.
# OUTBOX_DEAD_LETTER_RETAIN_DAYS=30
# OUTBOX_DEAD_LETTER_MAX_ROWS=50000
# Teslim EDILMIS komut kayitlari; teslim edilmemis + dead_letter budanmaz.
# COMMAND_LEDGER_RETAIN_DAYS=90

# --- Diger ------------------------------------------------------------------

# Gateway state dizini (outbox, ledger, config cache, instance lock).
# Coklu instance ayni makinede calisiyorsa HER BIRI ICIN FARKLI olmali.
# GATEWAY_STATE_DIR=.gateway_state

# Backend config yaniti icin maksimum boyut (byte). Backend bug yapip devasa
# JSON donerse OOM olmasin diye defansif sinir.
# BACKEND_RESPONSE_MAX_BYTES=10485760

# Cihaz IP'si loopback (127.0.0.1) ise container icinde host.docker.internal'a
# cevir. Docker OLMAYAN (NSSM/bare-metal) kurulumda FALSE yapin — aksi halde
# isim cozulmez ve cihaza baglanilamaz.
# REWRITE_LOOPBACK_TO_HOST=true

# --- YALNIZCA DNP3_LIBRARY=dnp3py (legacy) icin ------------------------------
# Bu ayarlar varsayilan yadnp3 adapter'inda ETKISIZDIR.
# DNP3_RESPONSE_TIMEOUT_SEC=15
# DNP3_READ_STRATEGY=event_driven
# DNP3_DIRECT_MAX_POINTS_PER_READ=24
# DNP3_DIRECT_SPARSE_RATIO=4
# DNP3_CONFIRM_REQUIRED=false
# DNP3_LINK_RESET_ON_CONNECT=true
# DNP3_DISABLE_UNSOLICITED_ON_CONNECT=false
# DNP3_UNSOLICITED_CLASS_MASK=7
# DNP3_LOG_RAW_FRAMES=false
